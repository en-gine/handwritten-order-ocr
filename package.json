{
  "name": "handwritten-order-ocr",
  "version": "1.0.0",
  "description": "Multi-tenant handwritten order OCR API using Gemini AI",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\""
  },
  "keywords": [
    "ocr",
    "handwriting",
    "gemini",
    "turso",
    "hono",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/papaparse": "^5.3.16",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.910.0",
    "@aws-sdk/s3-request-presigner": "^3.910.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/node-server": "^1.19.5",
    "@libsql/client": "^0.15.15",
    "@mastra/core": "^0.20.2",
    "@prisma/adapter-libsql": "^6.17.1",
    "@prisma/client": "^6.17.1",
    "hono": "^4.9.12",
    "hono-rate-limiter": "^0.4.2",
    "lru-cache": "^11.2.2",
    "papaparse": "^5.5.3",
    "zod": "^3.25.76"
  }
}
