# Node Environment
NODE_ENV=development

# Service Database (stores tenant metadata)
SERVICE_DATABASE_URL=libsql://ocr-service-db-[your-org].turso.io
SERVICE_DATABASE_TOKEN=your-service-db-token-here

# Parent Schema Database (defines structure)
SCHEMA_DATABASE_URL=libsql://ocr-seed-db-[your-org].turso.io
SCHEMA_DATABASE_TOKEN=your-schema-db-token-here

# Test Tenant Database (for local development)
TEST_TENANT_ID=tenant-test
TEST_TENANT_DATABASE_URL=libsql://ocr-tenant-test-[your-org].turso.io
TEST_TENANT_DATABASE_TOKEN=your-tenant-test-db-token-here

# Turso Platform API (for tenant provisioning)
# Get organization slug from: https://turso.tech/settings
# Create API token from: turso auth api-tokens create [name]
TURSO_ORGANIZATION=your-org-slug-here
TURSO_API_TOKEN=your-turso-platform-api-token-here
TURSO_GROUP=ai-ocr
SEED_DATABASE_NAME=ocr-seed-db

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
DEFAULT_AI_MODEL=gemini-2.0-flash-exp

# JWT Authentication (RS256 asymmetric signing)
# Generate RSA key pair with:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
# Then base64 encode both keys:
#   JWT_PRIVATE_KEY=$(cat private_key.pem | base64 | tr -d '\n')
#   JWT_PUBLIC_KEY=$(cat public_key.pem | base64 | tr -d '\n')
JWT_PRIVATE_KEY=base64-encoded-private-key-here
JWT_PUBLIC_KEY=base64-encoded-public-key-here
JWT_ISSUER=ocr-api.example.com
JWT_AUDIENCE=ocr-api

# File Storage (local development)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Production File Storage (Cloudflare R2, optional)
# R2_BUCKET_NAME=ai-ocr
# R2_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key

# API Configuration
API_PORT=3000
CONFIDENCE_THRESHOLD=0.70

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
