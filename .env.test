# Test Environment Configuration
# Local SQLite database for integration testing

DATABASE_URL="file:./tests/test.db"
DATABASE_TOKEN=""

# Service database (not used in unit tests)
SERVICE_DATABASE_URL="file:./tests/service-test.db"
SERVICE_DATABASE_TOKEN=""

# Configuration
GEMINI_API_KEY="test-api-key"
JWT_PRIVATE_KEY="test-private-key"
JWT_PUBLIC_KEY="test-public-key"

# Storage
STORAGE_TYPE="local"
LOCAL_STORAGE_PATH="./tests/uploads"

# Defaults
CONFIDENCE_THRESHOLD="0.70"
DEFAULT_AI_MODEL="gemini-2.0-flash-exp"
